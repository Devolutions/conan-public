 		set(FIDO_CFLAGS "${FIDO_CFLAGS} -D_GNU_SOURCE")
 		set(FIDO_CFLAGS "${FIDO_CFLAGS} -D_DEFAULT_SOURCE")
 	elseif(CMAKE_SYSTEM_NAME STREQUAL "FreeBSD" OR
@@ -121,6 +121,11 @@ check_symbol_exists(sysconf unistd.h HAVE_SYSCONF)
 check_symbol_exists(timespecsub sys/time.h HAVE_TIMESPECSUB)
 check_symbol_exists(timingsafe_bcmp string.h HAVE_TIMINGSAFE_BCMP)
 
+if(CMAKE_SYSTEM_NAME STREQUAL "Android")
+	set(HAVE_EXPLICIT_BZERO OFF)
+	add_definitions(-DCRYPTO_EXPLICIT_BZERO)
+endif()
+
 set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
 try_compile(HAVE_POSIX_IOCTL
     "${CMAKE_CURRENT_BINARY_DIR}/posix_ioctl_check.o"
@@ -223,9 +228,52 @@ if(MSVC)
 	set(NFC_LINUX OFF)
 else()
 	include(FindPkgConfig)
-	pkg_search_module(CBOR libcbor)
-	pkg_search_module(CRYPTO libcrypto)
-	pkg_search_module(ZLIB zlib)
+
+	if(ZLIB_ROOT_DIR)
+		list(PREPEND CMAKE_FIND_ROOT_PATH ${ZLIB_ROOT_DIR})
+	endif()
+	find_path(ZLIB_INCLUDE_DIR NAMES "zlib.h")
+	find_library(ZLIB_LIBRARY NAMES zlib z)
+	if(ZLIB_LIBRARY)
+		set(ZLIB_FOUND TRUE)
+		set(ZLIB_INCLUDE_DIRS "${ZLIB_INCLUDE_DIR}")
+		get_filename_component(ZLIB_LIBRARY_DIRS "${ZLIB_LIBRARY}" DIRECTORY)
+		set(ZLIB_LIBRARIES "${ZLIB_LIBRARY}")
+	else()
+		pkg_search_module(ZLIB zlib)
+	endif()
+
+	if(CBOR_ROOT_DIR)
+		list(PREPEND CMAKE_FIND_ROOT_PATH ${CBOR_ROOT_DIR})
+	endif()
+	find_path(CBOR_INCLUDE_DIR NAMES "cbor.h")
+	find_library(CBOR_LIBRARY NAMES libcbor cbor)
+	if(CBOR_LIBRARY)
+		set(CBOR_FOUND TRUE)
+		set(CBOR_INCLUDE_DIRS "${CBOR_INCLUDE_DIR}")
+		get_filename_component(CBOR_LIBRARY_DIRS "${CBOR_LIBRARY}" DIRECTORY)
+		set(CBOR_LIBRARIES "${CBOR_LIBRARY}")
+	else()
+		pkg_search_module(CBOR libcbor)
+	endif()
+
+	if(CRYPTO_ROOT_DIR)
+		list(PREPEND CMAKE_FIND_ROOT_PATH ${CRYPTO_ROOT_DIR})
+	endif()
+	find_path(CRYPTO_INCLUDE_DIR NAMES "openssl/opensslv.h")
+	find_library(CRYPTO_LIBRARY NAMES libcrypto crypto)
+	if(CRYPTO_LIBRARY)
+		set(CRYPTO_FOUND TRUE)
+		set(CRYPTO_INCLUDE_DIRS "${CRYPTO_INCLUDE_DIR}")
+		get_filename_component(CRYPTO_LIBRARY_DIRS "${CRYPTO_LIBRARY}" DIRECTORY)
+		set(CRYPTO_LIBRARIES "${CRYPTO_LIBRARY}")
+	else()
+		pkg_search_module(CRYPTO libcrypto)
+	endif()
+
+	include_directories("${ZLIB_INCLUDE_DIRS}")
+	include_directories("${CBOR_INCLUDE_DIRS}")
+	include_directories("${CRYPTO_INCLUDE_DIRS}")
 
 	if(NOT CBOR_FOUND AND NOT HAVE_CBOR_H)
 		message(FATAL_ERROR "could not find libcbor")
@@ -258,6 +306,18 @@ else()
 				set(BASE_LIBRARIES ${BASE_LIBRARIES} rt)
 			endif()
 		endif()
+	elseif(CMAKE_SYSTEM_NAME STREQUAL "Android")
+		if(UDEV_ROOT_DIR)
+			list(PREPEND CMAKE_FIND_ROOT_PATH ${UDEV_ROOT_DIR})
+		endif()
+		find_path(UDEV_INCLUDE_DIR NAMES "libudev.h")
+		find_library(UDEV_LIBRARY NAMES libudev-zero.a libudev)
+		set(UDEV_INCLUDE_DIRS "${UDEV_INCLUDE_DIR}")
+		get_filename_component(UDEV_LIBRARY_DIRS "${UDEV_LIBRARY}" DIRECTORY)
+		set(UDEV_LIBRARIES "${UDEV_LIBRARY}")
+		include_directories("${UDEV_INCLUDE_DIRS}")
+		message(STATUS "UDEV_INCLUDE_DIR: ${UDEV_INCLUDE_DIR}")
+		message(STATUS "UDEV_LIBRARY: ${UDEV_LIBRARY}")
 	else()
 		set(NFC_LINUX OFF)
 	endif()
